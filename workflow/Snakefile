def fasta_has_records(fasta):
    fasta = Path(fasta)

    if not fasta.exists() or fasta.stat().st_size == 0:
        return False

    with open(fasta) as handle:
        for line in handle:
            if line.startswith(">"):
                return True

    return False


def gff_has_features(gff):
    """
    Return True if the GFF file contains at least one gene, mRNA, or CDS feature.
    """
    gff = Path(gff)

    if not gff.exists() or gff.stat().st_size == 0:
        return False

    with open(gff) as handle:
        for line in handle:
            if line.startswith("#"):
                continue

            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 3 and parts[2] in {"gene", "mRNA", "CDS"}:
                return True

    return False

def _fungal_summary_targets_for_pool(sample_pool):
    """
    Return fungal_summary.tsv only if the given assembly unit has
    eukaryotic sequences and augustify produced gene annotations.

    Otherwise return an empty list, so summarize_antismash_fungal
    will not be requested.
    """
    whokaryote_ckpt = checkpoints.whokaryote.get(sample=sample_pool)
    euk_fasta = whokaryote_ckpt.output.euk_fasta

    if not fasta_has_records(euk_fasta):
        return []

    augustify_ckpt = checkpoints.augustify.get(sample=sample_pool)
    gff = augustify_ckpt.output.gff

    if not gff_has_features(gff):
        return []

    return [
        f"{outdir}/results/08_BGC/antismash/{sample_pool}/fungal/fungal_summary.tsv"
    ]


def fungal_summary_targets(wildcards):
    """Input-function form, for rules with their own {sample_pool} wildcard."""
    return _fungal_summary_targets_for_pool(wildcards.sample_pool)


def all_fungal_summary_targets(wildcards):
    """Aggregate fungal_summary_targets() across all assembly units, for rule all."""
    return [
        target
        for sample_pool in ASSEMBLY_UNITS
        for target in _fungal_summary_targets_for_pool(sample_pool)
    ]

